                    {
                      "type": "statichtml",
                      "inputClass": "col-md-6",
                      "html": "<table border=\"1\" style=\"border-collapse: collapse; width: 100%;\"><colgroup><col style=\"width: 99.6528%;\"></colgroup>\n<tbody>\n<tr>\n<td>\n<p>\"My bad <strong>$value -customer(firstname)$</strong>. I guess either I missed the mark or you would have reached out to us if you were interested.\"</p>\n</td>\n</tr>\n</tbody>\n</table>",
