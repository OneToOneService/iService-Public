          "customHead": "<script>\nfunction toggleMenu() {\n  document.getElementById(\"navMenu\").classList.toggle(\"active\");\n}\n</script>\n<style>\nbody {\n  margin: 0;\n  font-family: Arial, sans-serif;\n}\n\n/* HEADER */\n.header {\n  background-color: #4D148C;\n  color: #fff;\n  padding: 20px 16px;\n}\n\n/* WRAPPER */\n.header-wrapper {\n  max-width: 960px;\n  margin: 0 auto;\n  display: flex;\n  align-items: center;\n}\n\n/* LOGO */\n.logo{width:123px;}\n.logo img {\n  max-width: 80px;\n}\n\n/* NAV */\n.nav {\n  display: flex;\n  gap: 20px;\n  margin-left: 20px;\n  align-items: center;\n}\n\n.nav a {\n  color: #fff;\n  text-decoration: none;\n  font-size: 14px;\n}\n.nav a:hover {text-decoration:underline !important;}\n/* RIGHT SECTION */\n.right-section {\n  margin-left: auto;\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n\n.right-section a {\n  color: #fff;\n  text-decoration: none;\n  font-size: 14px;\n}\n\n/* ICON */\n.icon-user {\n  width: 27px;\n  height: 27px;\n  background-image: url(\"https://www.fedex.com/etc.clientlibs/clientlibs/fedex/images/resources/menu-sprite.png\");\n  background-size: 77px 56px;\n  background-position: -12px 0;\n}\n\n/* TOGGLE BUTTON */\n.menu-toggle {\n  display: none;\n  font-size: 22px;\n  cursor: pointer;\n  margin-left: auto;\n}\n\n/* VISIBILITY CONTROL */\n.mobile-only { display: none; }\n.desktop-only { display: flex; }\n\n/* ================= MOBILE ================= */\n@media (max-width: 768px) {\n\n  .header-wrapper {\n    flex-wrap: wrap;\n  }\n\n  /* SHOW HAMBURGER */\n  .menu-toggle {\n    display: block;\n  }\n\n  /* HIDE DESKTOP RIGHT */\n  .desktop-only {\n    display: none;\n  }\n\n  /* NAV DROPDOWN */\n  .nav {\n    width: 100%;\n    flex-direction: column;\n    display: none;\n    margin-top: 10px;\n  }\n\n  .nav.active {\n    display: flex;\n  }\n\n  .nav a {\n    padding: 10px 0;\n    border-top: 1px solid rgba(255,255,255,0.2);\n    width: 100%;\n  }\n\n  /* MOBILE RIGHT SECTION */\n  .mobile-only {\n    display: flex;\n    flex-direction: column;\n    gap: 10px;\n    margin-top: 10px;\n    width: 100%;\n  }\n\n  .mobile-only a {\n    padding: 10px 0;\n    border-top: 1px solid rgba(255,255,255,0.2);\n  }\n}\n</style>\n\n<div class=\"header\">\n  <div class=\"header-wrapper\">\n\n    <!-- LOGO -->\n    <div class=\"logo\"><a href=\"https://www.fedexfreight.com/en-us\">\n<img src=\"https://www.fedexfreight.com/en-us/media_13a53b86c559d3a55ed83f8019eb328d0288b3736.svg?width=164&format=webply&optimize=medium\" width=\"140\" style=\"max-width:140px !Important;\"></a>\n    \n    </div>\n\n    <!-- MOBILE MENU BUTTON -->\n    <div class=\"menu-toggle\" onclick=\"toggleMenu()\">☰</div>\n\n    <!-- NAV + RIGHT SECTION (COMBINED FOR MOBILE) -->\n    <div class=\"nav\" id=\"navMenu\">\n      <a href=\"https://www.fedex.com/en-us/custom-critical.html\">Shipping</a>\n      <a href=\"https://www.fedex.com/en-us/custom-critical.html\">Tracking</a>\n      <a href=\"https://www.fedex.com/en-us/custom-critical.html\">Design & Print</a>\n      <a href=\"https://www.fedex.com/en-us/custom-critical.html\">Locations</a>\n      <a href=\"https://www.fedex.com/en-us/custom-critical.html\">Support</a>\n\n      <!-- RIGHT SECTION INSIDE MENU -->\n      <div class=\"right-section mobile-only\">\n        <a href=\"https://www.fedex.com/secure-login/en-us/#\">Sign Up or Log In</a>\n        <span class=\"icon-user\"></span>\n      </div>\n    </div>\n\n    <!-- DESKTOP RIGHT SECTION -->\n    <div class=\"right-section desktop-only\">\n      <a href=\"https://www.fedex.com/secure-login/en-us/#/\">Sign Up or Log In</a>\n      <span class=\"icon-user\"></span>\n    </div>\n\n  </div>\n</div>",
